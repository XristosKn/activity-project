<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ActivityProjectApp.Models"
             x:Class="ActivityProjectApp.Views.CustomerProfileView"
             Background="#F4F6F8">

    <UserControl.Styles>

        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E3A8A"/>
        </Style>

        <Style Selector="TextBlock.subsection-title">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>

        <Style Selector="Button.topbar-button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.topbar-button:pointerover">
            <Setter Property="Background" Value="#EEF2F7"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <Style Selector="Button.carousel-button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.carousel-button:pointerover">
            <Setter Property="Background" Value="#EEF2F7"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <Style Selector="Button.settings-option-button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <Style Selector="Button.settings-option-button:pointerover">
            <Setter Property="Background" Value="#EEF2F7"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <Style Selector="Border.profile-section">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Border.profile-card">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*"
          Background="#F4F6F8">

        <!-- Top bar -->
        <Border Grid.Row="0"
                Background="White"
                Padding="24,18"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

            <Grid ColumnDefinitions="*,Auto">

                <StackPanel Grid.Column="0"
                            Spacing="4">

                    <TextBlock Text="Customer Profile"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#1E3A8A"/>

                    <TextBlock x:Name="CustomerInfoTextBlock"
                               Text="Profile overview"
                               FontSize="14"
                               Foreground="#6B7280"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">

                    <Button x:Name="BackButton"
                            Classes="topbar-button"
                            Content="Back"/>

                    <Button x:Name="SettingsButton"
                            Classes="topbar-button"
                            Content="Settings"/>

                    <Button x:Name="LogoutButton"
                            Classes="topbar-button"
                            Content="Logout"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- Main content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <Grid Margin="30"
                  RowDefinitions="Auto,Auto,Auto,Auto">

                <!-- Announcements -->
                <Border x:Name="AnnouncementsSectionPanel"
                        Grid.Row="0"
                        Classes="profile-section"
                        Margin="0,0,0,22">

                    <StackPanel Spacing="14">

                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">

                            <TextBlock Grid.Column="0"
                                       Text="Announcements"
                                       Classes="section-title"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="AnnouncementsCountTextBlock"
                                       Grid.Column="1"
                                       Text="0 announcements"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>

                            <Button x:Name="PreviousAnnouncementsButton"
                                    Grid.Column="2"
                                    Classes="carousel-button"
                                    Content="‹"
                                    Margin="0,0,8,0"/>

                            <Button x:Name="NextAnnouncementsButton"
                                    Grid.Column="3"
                                    Classes="carousel-button"
                                    Content="›"/>

                        </Grid>

                        <TextBlock x:Name="AnnouncementsEmptyTextBlock"
                                   Text="No announcements available."
                                   FontSize="14"
                                   Foreground="#6B7280"
                                   IsVisible="False"/>

                        <ItemsControl x:Name="AnnouncementsItemsControl">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="12"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>

                                <DataTemplate DataType="{x:Type models:Announcement}">

                                    <Border Classes="profile-card"
                                            Width="220"
                                            MinHeight="160">

                                        <StackPanel Spacing="8">

                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="#111827"
                                                       TextWrapping="Wrap"/>

                                            <Border Background="#E5E7EB"
                                                    CornerRadius="10"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Left">

                                                <TextBlock Text="{Binding ItemType}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#374151"/>

                                            </Border>

                                            <TextBlock Text="{Binding Text}"
                                                       FontSize="13"
                                                       Foreground="#4B5563"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="62"/>

                                            <TextBlock Text="{Binding AnnouncementDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                       FontSize="12"
                                                       Foreground="#6B7280"/>

                                        </StackPanel>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

                <!-- Saved items -->
                <Border x:Name="SavedItemsSectionPanel"
                        Grid.Row="1"
                        Classes="profile-section"
                        Margin="0,0,0,22">

                    <StackPanel Spacing="14">

                        <Grid ColumnDefinitions="*,Auto,Auto"
                              Margin="0,0,0,4">

                            <TextBlock Grid.Column="0"
                                       Text="Saved Events / Courses"
                                       Classes="section-title"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="SavedItemsCountTextBlock"
                                       Grid.Column="1"
                                       Text="0 saved"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>

                            <ComboBox x:Name="SavedItemsFilterComboBox"
                                      Grid.Column="2"
                                      Width="150"
                                      Height="34"
                                      SelectedIndex="0">

                                <ComboBoxItem Content="All"/>
                                <ComboBoxItem Content="Events"/>
                                <ComboBoxItem Content="Courses"/>

                            </ComboBox>

                        </Grid>

                        <ItemsControl x:Name="SavedItemsControl">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate DataType="{x:Type models:CustomerProfileItem}">

                                    <Border Classes="profile-card"
                                            Margin="0,0,0,10">

                                        <StackPanel Spacing="6">

                                            <Grid ColumnDefinitions="*,Auto">

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Title}"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           Foreground="#111827"
                                                           TextWrapping="Wrap"/>

                                                <Border Grid.Column="1"
                                                        Background="#E5E7EB"
                                                        CornerRadius="10"
                                                        Padding="8,3"
                                                        Margin="8,0,0,0">

                                                    <TextBlock Text="{Binding ItemTypeText}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#374151"/>

                                                </Border>

                                            </Grid>

                                            <TextBlock Text="{Binding Category}"
                                                       FontSize="13"
                                                       Foreground="#4B5563"/>

                                            <TextBlock Text="{Binding ScheduleText}"
                                                       FontSize="13"
                                                       Foreground="#6B7280"/>

                                        </StackPanel>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

                <!-- My enrolled items -->
                <Border x:Name="MyItemsSectionPanel"
                        Grid.Row="2"
                        Classes="profile-section">

                    <StackPanel Spacing="14">

                        <Grid ColumnDefinitions="*,Auto,Auto"
                              Margin="0,0,0,4">

                            <TextBlock Grid.Column="0"
                                       Text="My Events / Courses"
                                       Classes="section-title"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="MyItemsCountTextBlock"
                                       Grid.Column="1"
                                       Text="0 enrolled"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>

                            <ComboBox x:Name="MyItemsFilterComboBox"
                                      Grid.Column="2"
                                      Width="150"
                                      Height="34"
                                      SelectedIndex="0">

                                <ComboBoxItem Content="All"/>
                                <ComboBoxItem Content="Events"/>
                                <ComboBoxItem Content="Courses"/>

                            </ComboBox>

                        </Grid>

                        <TextBlock Text="Confirmed enrollments will appear here."
                                   FontSize="13"
                                   Foreground="#6B7280"/>

                        <ItemsControl x:Name="MyItemsControl">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate DataType="{x:Type models:CustomerProfileItem}">

                                    <Border Classes="profile-card"
                                            Margin="0,0,0,10">

                                        <StackPanel Spacing="6">

                                            <Grid ColumnDefinitions="*,Auto">

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Title}"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           Foreground="#111827"
                                                           TextWrapping="Wrap"/>

                                                <Border Grid.Column="1"
                                                        Background="#DCFCE7"
                                                        CornerRadius="10"
                                                        Padding="8,3"
                                                        Margin="8,0,0,0">

                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#166534"/>

                                                </Border>

                                            </Grid>

                                            <TextBlock Text="{Binding ItemTypeText}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#374151"/>

                                            <TextBlock Text="{Binding Category}"
                                                       FontSize="13"
                                                       Foreground="#4B5563"/>

                                            <TextBlock Text="{Binding ScheduleText}"
                                                       FontSize="13"
                                                       Foreground="#6B7280"/>

                                        </StackPanel>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

                <!-- Settings -->
                <Border x:Name="SettingsSectionPanel"
                        Grid.Row="3"
                        Classes="profile-section"
                        IsVisible="False">

                    <StackPanel Spacing="16">

                        <TextBlock Text="Settings"
                                   Classes="section-title"/>

                        <TextBlock Text="Manage your account preferences and personal information."
                                   FontSize="14"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap"/>

                        <Border Background="#F9FAFB"
                                CornerRadius="14"
                                Padding="16"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">

                            <StackPanel Spacing="12">

                                <TextBlock Text="Account Settings"
                                           Classes="subsection-title"/>

                                <Button Content="Change Password"
                                        Classes="settings-option-button"/>

                                <Button Content="Change Email"
                                        Classes="settings-option-button"/>

                                <Button Content="Update Phone Number"
                                        Classes="settings-option-button"/>

                            </StackPanel>

                        </Border>

                        <Border Background="#F9FAFB"
                                CornerRadius="14"
                                Padding="16"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">

                            <StackPanel Spacing="12">

                                <TextBlock Text="Profile Preferences"
                                           Classes="subsection-title"/>

                                <Button Content="Update Personal Information"
                                        Classes="settings-option-button"/>

                                <Button Content="Location &amp; Privacy Settings"
                                        Classes="settings-option-button"/>

                                <TextBlock Text="These settings are placeholders and will be implemented later."
                                           FontSize="13"
                                           Foreground="#6B7280"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Border>

            </Grid>

        </ScrollViewer>

    </Grid>

</UserControl>