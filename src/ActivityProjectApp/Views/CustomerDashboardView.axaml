<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ActivityProjectApp.Models"
             xmlns:converters="clr-namespace:ActivityProjectApp.Converters"
             x:Class="ActivityProjectApp.Views.CustomerDashboardView"
             Background="#F3F6FA">

    <UserControl.Resources>
        <converters:CategoryBrushConverter x:Key="CategoryBrushConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>

        <!-- Shared template for blue primary buttons -->
        <Style Selector="Button.primary-action">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>

            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">

                        <ContentPresenter Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Padding="{TemplateBinding Padding}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>

                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.primary-action:pointerover">
            <Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
        </Style>

        <Style Selector="Button.primary-action:pressed">
            <Setter Property="Background" Value="#1E40AF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1E40AF"/>
        </Style>


        <!-- Save button when not saved -->
        <Style Selector="Button.save-action">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>

            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">

                        <ContentPresenter Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Padding="{TemplateBinding Padding}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>

                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.save-action:pointerover">
            <Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
        </Style>

        <Style Selector="Button.save-action:pressed">
            <Setter Property="Background" Value="#1E40AF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1E40AF"/>
        </Style>


        <!-- Save button when already saved -->
        <Style Selector="Button.save-action.saved">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
        </Style>

        <Style Selector="Button.save-action.saved:pointerover">
            <Setter Property="Background" Value="#B91C1C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#B91C1C"/>
        </Style>

        <Style Selector="Button.save-action.saved:pressed">
            <Setter Property="Background" Value="#991B1B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#991B1B"/>
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*"
          Background="#F3F6FA">

        <!-- Top bar -->
        <Border Grid.Row="0"
                Background="White"
                Padding="22,18"
                BorderBrush="#E1E5EA"
                BorderThickness="0,0,0,1">

            <DockPanel LastChildFill="True">

                <Button x:Name="LogoutButton"
                        DockPanel.Dock="Right"
                        Content="Logout"
                        Width="110"
                        Height="38"
                        Background="#F1F3F5"
                        Foreground="#1F2937"
                        HorizontalContentAlignment="Center"/>

                <StackPanel DockPanel.Dock="Left"
                            Spacing="3">

                    <TextBlock Text="Activity Map"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#111827"/>

                    <TextBlock x:Name="WelcomeTextBlock"
                               Text="Welcome"
                               FontSize="14"
                               Foreground="#6B7280"/>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1"
              Margin="28"
              RowDefinitions="Auto,*">

            <!-- Search panel -->
            <Border Grid.Row="0"
                    Background="White"
                    CornerRadius="18"
                    Padding="18"
                    Margin="0,0,0,20"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                <Grid ColumnDefinitions="*,Auto,Auto">

                    <TextBox x:Name="SearchTextBox"
                            Grid.Column="0"
                            Watermark="Search by activity, category, description or area..."
                            Height="42"
                            Margin="0,0,12,0"
                            Background="#F9FAFB"
                            Foreground="#111827"
                            BorderBrush="#D1D5DB"/>

                    <Button x:Name="SearchButton"
                            Classes="primary-action"
                            Grid.Column="1"
                            Content="Search"
                            Width="120"
                            Height="42"
                            Margin="0,0,10,0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>

                    <Button x:Name="ClearSearchButton"
                            Grid.Column="2"
                            Content="Clear"
                            Width="90"
                            Height="42"
                            Background="#F1F3F5"
                            Foreground="#111827"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>

                </Grid>

            </Border>

            <!-- Map and list section -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="2*,430">

                <!-- Map column -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="20"
                        Padding="20"
                        Margin="0,0,20,0"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <Grid RowDefinitions="Auto,*,Auto">

                        <!-- Map header -->
                        <Grid Grid.Row="0"
                              ColumnDefinitions="*,Auto"
                              Margin="0,0,0,14">

                            <StackPanel Grid.Column="0"
                                        Spacing="4">

                                <TextBlock Text="Explore Activities Near You"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#111827"/>

                                <TextBlock Text="Move around the map and click an activity point to preview details."
                                           FontSize="14"
                                           Foreground="#6B7280"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="#EFF6FF"
                                    CornerRadius="18"
                                    Padding="12,8"
                                    VerticalAlignment="Center">

                                <TextBlock Text="OpenStreetMap"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#1D4ED8"/>

                            </Border>

                        </Grid>

                        <!-- Real map area -->
                        <Border Grid.Row="1"
                                Background="#DCEAF5"
                                CornerRadius="18"
                                ClipToBounds="True"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1">

                            <Grid>

                                <!-- Mapsui map is inserted here from C# -->
                                <ContentControl x:Name="MapHost"/>

                                <!-- Map toolbar -->
                                <Border HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="14"
                                        Background="#F9FAFB"
                                        CornerRadius="14"
                                        Padding="8"
                                        BorderBrush="#D1D5DB"
                                        BorderThickness="1">

                                    <StackPanel Spacing="8">

                                        <Button x:Name="ZoomInButton"
                                                Content="+"
                                                Width="42"
                                                Height="42"
                                                FontSize="22"
                                                FontWeight="Bold"
                                                Background="White"
                                                Foreground="#111827"
                                                BorderBrush="#D1D5DB"
                                                HorizontalContentAlignment="Center"/>

                                        <Button x:Name="ZoomOutButton"
                                                Content="-"
                                                Width="42"
                                                Height="42"
                                                FontSize="22"
                                                FontWeight="Bold"
                                                Background="White"
                                                Foreground="#111827"
                                                BorderBrush="#D1D5DB"
                                                HorizontalContentAlignment="Center"/>

                                        <Button x:Name="CenterMapButton"
                                                Content="⌖"
                                                Width="42"
                                                Height="42"
                                                FontSize="18"
                                                FontWeight="Bold"
                                                Background="White"
                                                Foreground="#111827"
                                                BorderBrush="#D1D5DB"
                                                HorizontalContentAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="14"
                                        Background="#FFFFFF"
                                        CornerRadius="14"
                                        Padding="12,8"
                                        BorderBrush="#D1D5DB"
                                        BorderThickness="1">

                                    <TextBlock Text="Drag map • Click activity points"
                                               FontSize="12"
                                               Foreground="#374151"/>

                                </Border>

                            </Grid>

                        </Border>

                        <!-- Selected event details -->
                        <Border Grid.Row="2"
                                x:Name="SelectedEventPanel"
                                IsVisible="False"
                                Background="#F9FAFB"
                                CornerRadius="18"
                                Padding="18"
                                Margin="0,16,0,0"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">

                            <Grid ColumnDefinitions="*,Auto">

                                <StackPanel Grid.Column="0"
                                            Spacing="6">

                                    <TextBlock x:Name="SelectedEventTitleTextBlock"
                                               Text=""
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="#111827"/>

                                    <TextBlock x:Name="SelectedEventCategoryTextBlock"
                                               Text=""
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#2563EB"/>

                                    <TextBlock x:Name="SelectedEventAddressTextBlock"
                                               Text=""
                                               FontSize="14"
                                               Foreground="#4B5563"
                                               TextWrapping="Wrap"/>

                                    <TextBlock x:Name="SelectedEventInfoTextBlock"
                                               Text=""
                                               FontSize="13"
                                               Foreground="#6B7280"/>

                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="10"
                                            VerticalAlignment="Center">

                                    <Button x:Name="EnrollButton"
                                            Classes="primary-action"
                                            Content="Enroll"
                                            Width="96"
                                            Height="38"
                                            HorizontalContentAlignment="Center"/>

                                    <Button x:Name="SaveButton"
                                            Classes="save-action"
                                            Content="Save"
                                            Width="86"
                                            Height="38"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </Grid>

                </Border>

                <!-- Events list column -->
                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="20"
                        Padding="20"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <Grid RowDefinitions="Auto,Auto,*">

                        <StackPanel Grid.Row="0"
                                    Spacing="4"
                                    Margin="0,0,0,12">

                            <TextBlock Text="Available Events / Courses"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="#111827"/>

                            <TextBlock x:Name="EventsCountTextBlock"
                                       Text="0 events found"
                                       FontSize="13"
                                       Foreground="#6B7280"/>

                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   x:Name="DashboardMessageTextBlock"
                                   Text=""
                                   FontSize="13"
                                   Foreground="#DC2626"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto">

                            <ListBox x:Name="AvailableEventsItemsControl"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    SelectionMode="Single">

                                <ListBox.Styles>

                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,12"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>

                                        <Setter Property="Template">
                                            <ControlTemplate>
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                Padding="{TemplateBinding Padding}"
                                                                HorizontalContentAlignment="Stretch"
                                                                VerticalContentAlignment="Stretch"/>
                                            </ControlTemplate>
                                        </Setter>
                                    </Style>

                                    <Style Selector="ListBoxItem:pointerover">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>

                                    <Style Selector="ListBoxItem:selected">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>

                                    <Style Selector="ListBoxItem:selected:pointerover">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>

                                    <!-- Default event card style -->
                                    <Style Selector="Border.event-card">
                                        <Setter Property="Background" Value="#F9FAFB"/>
                                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </Style>

                                    <!-- Hovered event card style -->
                                    <Style Selector="ListBoxItem:pointerover Border.event-card">
                                        <Setter Property="Background" Value="#F3F4F6"/>
                                        <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                    </Style>

                                    <!-- Selected event card style -->
                                    <Style Selector="ListBoxItem:selected Border.event-card">
                                        <Setter Property="Background" Value="#E5E7EB"/>
                                        <Setter Property="BorderBrush" Value="#9CA3AF"/>
                                    </Style>

                                </ListBox.Styles>

                                <ListBox.ItemTemplate>

                                    <DataTemplate DataType="{x:Type models:CustomerActivityListItem}">

                                        <Border Classes="event-card"
                                                CornerRadius="14"
                                                Padding="14">

                                            <StackPanel Spacing="7">

                                                <Grid ColumnDefinitions="*,Auto">

                                                    <TextBlock Grid.Column="0"
                                                            Text="{Binding Title}"
                                                            FontSize="17"
                                                            FontWeight="Bold"
                                                            Foreground="#111827"
                                                            TextWrapping="Wrap"/>

                                                    <Border Grid.Column="1"
                                                            Background="#E5E7EB"
                                                            CornerRadius="10"
                                                            Padding="8,3"
                                                            Margin="8,0,0,0">

                                                        <TextBlock Text="{Binding ActivityType}"
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                Foreground="#374151"/>

                                                    </Border>

                                                </Grid>

                                                <Border Background="#EFF6FF"
                                                        CornerRadius="12"
                                                        Padding="8,4"
                                                        HorizontalAlignment="Left">

                                                    <TextBlock Text="{Binding Category}"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="{Binding Category, Converter={StaticResource CategoryBrushConverter}}"/>

                                                </Border>

                                                <TextBlock Text="{Binding Address}"
                                                        FontSize="13"
                                                        Foreground="#4B5563"
                                                        TextWrapping="Wrap"/>

                                                <TextBlock Text="{Binding ScheduleText}"
                                                        FontSize="13"
                                                        Foreground="#4B5563"
                                                        TextWrapping="Wrap"/>

                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="8">

                                                    <TextBlock Text="Price:"
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            Foreground="#374151"/>

                                                    <TextBlock Text="{Binding PriceText}"
                                                            FontSize="13"
                                                            Foreground="#059669"/>

                                                </StackPanel>

                                                <TextBlock Text="Click to view on map"
                                                        FontSize="12"
                                                        FontStyle="Italic"
                                                        Foreground="#6B7280"/>

                                            </StackPanel>

                                        </Border>

                                    </DataTemplate>

                                </ListBox.ItemTemplate>

                            </ListBox>

                        </ScrollViewer>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</UserControl>