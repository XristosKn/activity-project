<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ActivityProjectApp.Models"
             x:Class="ActivityProjectApp.Views.CustomerProfileView"
             Background="#F3F6FA">

    <Grid RowDefinitions="Auto,*"
          Background="#F3F6FA">

        <!-- Top bar -->
        <Border Grid.Row="0"
                Background="White"
                Padding="22,18"
                BorderBrush="#E1E5EA"
                BorderThickness="0,0,0,1">

            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="10">

                    <Button x:Name="BackButton"
                            Content="Back"
                            Width="110"
                            Height="38"
                            Background="#F1F3F5"
                            Foreground="#1F2937"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>

                    <Button x:Name="LogoutButton"
                            Content="Logout"
                            Width="110"
                            Height="38"
                            Background="#F1F3F5"
                            Foreground="#1F2937"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>

                </StackPanel>

                <StackPanel DockPanel.Dock="Left"
                            Spacing="3">

                    <TextBlock Text="Customer Profile"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#111827"/>

                    <TextBlock x:Name="CustomerInfoTextBlock"
                               Text="Profile overview"
                               FontSize="14"
                               Foreground="#6B7280"/>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- Main content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <Grid Margin="28"
                  RowDefinitions="Auto,Auto,Auto">

                <!-- Announcements -->
                <Border Grid.Row="0"
                        Background="White"
                        CornerRadius="20"
                        Padding="22"
                        Margin="0,0,0,20"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <StackPanel Spacing="12">

                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">

                            <TextBlock Grid.Column="0"
                                    Text="Announcements"
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="#111827"
                                    VerticalAlignment="Center"/>

                            <TextBlock x:Name="AnnouncementsCountTextBlock"
                                    Grid.Column="1"
                                    Text="0 announcements"
                                    FontSize="13"
                                    Foreground="#6B7280"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"/>

                            <Button x:Name="PreviousAnnouncementsButton"
                                    Grid.Column="2"
                                    Content="‹"
                                    Width="38"
                                    Height="34"
                                    FontSize="20"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Margin="0,0,8,0"/>

                            <Button x:Name="NextAnnouncementsButton"
                                    Grid.Column="3"
                                    Content="›"
                                    Width="38"
                                    Height="34"
                                    FontSize="20"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"/>

                        </Grid>

                        <TextBlock x:Name="AnnouncementsEmptyTextBlock"
                                Text="No announcements available."
                                FontSize="14"
                                Foreground="#6B7280"
                                IsVisible="False"/>

                        <ItemsControl x:Name="AnnouncementsItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="12"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Announcement}">

                                    <Border Background="#F9FAFB"
                                            CornerRadius="14"
                                            Padding="14"
                                            Width="210"
                                            MinHeight="150"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="1">

                                        <StackPanel Spacing="7">

                                            <TextBlock Text="{Binding Title}"
                                                    FontSize="15"
                                                    FontWeight="Bold"
                                                    Foreground="#111827"
                                                    TextWrapping="Wrap"/>

                                            <Border Background="#E5E7EB"
                                                    CornerRadius="10"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Left">

                                                <TextBlock Text="{Binding ItemType}"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="#374151"/>

                                            </Border>

                                            <TextBlock Text="{Binding Text}"
                                                    FontSize="13"
                                                    Foreground="#4B5563"
                                                    TextWrapping="Wrap"
                                                    MaxHeight="60"/>

                                            <TextBlock Text="{Binding AnnouncementDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                    FontSize="12"
                                                    Foreground="#6B7280"/>

                                        </StackPanel>

                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>

                </Border>

                <!-- Saved items -->
                <Border Grid.Row="1"
                        Background="White"
                        CornerRadius="20"
                        Padding="22"
                        Margin="0,0,0,20"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <StackPanel Spacing="12">

                        <Grid ColumnDefinitions="*,Auto,Auto"
                            Margin="0,0,0,4">

                            <TextBlock Grid.Column="0"
                                    Text="Saved Events / Courses"
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="#111827"
                                    VerticalAlignment="Center"/>

                            <TextBlock x:Name="SavedItemsCountTextBlock"
                                    Grid.Column="1"
                                    Text="0 saved"
                                    FontSize="13"
                                    Foreground="#6B7280"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"/>

                            <ComboBox x:Name="SavedItemsFilterComboBox"
                                    Grid.Column="2"
                                    Width="150"
                                    Height="34"
                                    SelectedIndex="0">
                                <ComboBoxItem Content="All"/>
                                <ComboBoxItem Content="Events"/>
                                <ComboBoxItem Content="Courses"/>
                            </ComboBox>

                        </Grid>

                        <ItemsControl x:Name="SavedItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:CustomerProfileItem}">
                                    <Border Background="#F9FAFB"
                                            CornerRadius="14"
                                            Padding="14"
                                            Margin="0,0,0,10"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="1">

                                        <StackPanel Spacing="5">

                                            <Grid ColumnDefinitions="*,Auto">

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Title}"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           Foreground="#111827"
                                                           TextWrapping="Wrap"/>

                                                <Border Grid.Column="1"
                                                        Background="#E5E7EB"
                                                        CornerRadius="10"
                                                        Padding="8,3"
                                                        Margin="8,0,0,0">

                                                    <TextBlock Text="{Binding ItemTypeText}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#374151"/>

                                                </Border>

                                            </Grid>

                                            <TextBlock Text="{Binding Category}"
                                                       FontSize="13"
                                                       Foreground="#4B5563"/>

                                            <TextBlock Text="{Binding ScheduleText}"
                                                       FontSize="13"
                                                       Foreground="#6B7280"/>

                                        </StackPanel>

                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>

                </Border>

                <!-- My enrolled items -->
                <Border Grid.Row="2"
                        Background="White"
                        CornerRadius="20"
                        Padding="22"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <StackPanel Spacing="12">

                        <Grid ColumnDefinitions="*,Auto,Auto"
                            Margin="0,0,0,4">

                            <TextBlock Grid.Column="0"
                                    Text="My Events / Courses"
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="#111827"
                                    VerticalAlignment="Center"/>

                            <TextBlock x:Name="MyItemsCountTextBlock"
                                    Grid.Column="1"
                                    Text="0 enrolled"
                                    FontSize="13"
                                    Foreground="#6B7280"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"/>

                            <ComboBox x:Name="MyItemsFilterComboBox"
                                    Grid.Column="2"
                                    Width="150"
                                    Height="34"
                                    SelectedIndex="0">
                                <ComboBoxItem Content="All"/>
                                <ComboBoxItem Content="Events"/>
                                <ComboBoxItem Content="Courses"/>
                            </ComboBox>

                        </Grid>

                        <TextBlock Text="Confirmed enrollments will appear here."
                                   FontSize="13"
                                   Foreground="#6B7280"/>

                        <ItemsControl x:Name="MyItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:CustomerProfileItem}">
                                    <Border Background="#F9FAFB"
                                            CornerRadius="14"
                                            Padding="14"
                                            Margin="0,0,0,10"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="1">

                                        <StackPanel Spacing="5">

                                            <Grid ColumnDefinitions="*,Auto">

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Title}"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           Foreground="#111827"
                                                           TextWrapping="Wrap"/>

                                                <Border Grid.Column="1"
                                                        Background="#DCFCE7"
                                                        CornerRadius="10"
                                                        Padding="8,3"
                                                        Margin="8,0,0,0">

                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#166534"/>

                                                </Border>

                                            </Grid>

                                            <TextBlock Text="{Binding ItemTypeText}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#374151"/>

                                            <TextBlock Text="{Binding Category}"
                                                       FontSize="13"
                                                       Foreground="#4B5563"/>

                                            <TextBlock Text="{Binding ScheduleText}"
                                                       FontSize="13"
                                                       Foreground="#6B7280"/>

                                        </StackPanel>

                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>

                </Border>

            </Grid>

        </ScrollViewer>

    </Grid>

</UserControl>