<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ActivityProjectApp.Models"
             x:Class="ActivityProjectApp.Views.ServiceProviderDashboardView"
             Background="#F4F6F8">

    <Grid RowDefinitions="Auto,*"
          Background="#F4F6F8">

        <!-- Top bar -->
        <Border Grid.Row="0"
                Background="White"
                Padding="20"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1">

            <DockPanel>

                <StackPanel DockPanel.Dock="Left"
                            Spacing="4">
                    <TextBlock Text="Service Provider Dashboard"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="Black"/>

                    <TextBlock x:Name="WelcomeTextBlock"
                               Text="Welcome"
                               FontSize="14"
                               Foreground="#666666"/>
                </StackPanel>

                <Button x:Name="LogoutButton"
                        Content="Logout"
                        Width="100"
                        Height="36"
                        HorizontalContentAlignment="Center"
                        DockPanel.Dock="Right"/>

            </DockPanel>

        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1"
              Margin="30"
              ColumnDefinitions="260,*">

            <!-- Side menu -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,25,0">

                <StackPanel Spacing="12">

                    <TextBlock Text="Menu"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="Black"/>

                    <Button x:Name="CreateEventButton"
                                Content="Create Event / Course"
                                Height="40"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"/>

                    <Button x:Name="MyActivitiesButton"
                            Content="My Activities"
                            Height="40"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"/>

                    <Button x:Name="BookingsButton"
                            Content="Bookings"
                            Height="40"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"/>

                    <Button x:Name="ProfileButton"
                            Content="Profile"
                            Height="40"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"/>

                </StackPanel>

            </Border>

            <!-- Dashboard area -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="25">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Spacing="18">

                        <TextBlock Text="Overview"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="Black"/>

                        <TextBlock Text="This is the main page for service providers. From here, providers will be able to create and manage activities."
                                   FontSize="14"
                                   Foreground="#555555"
                                   TextWrapping="Wrap"/>

                        <UniformGrid Columns="3"
                                     Rows="1">

                            <Border Background="#F4F6F8"
                                    CornerRadius="10"
                                    Padding="20"
                                    Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock x:Name="ActiveActivitiesCountTextBlock"
                                               Text="0"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               Foreground="Black"/>
                                    <TextBlock Text="Active Activities"
                                               Foreground="#666666"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#F4F6F8"
                                    CornerRadius="10"
                                    Padding="20"
                                    Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="0"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               Foreground="Black"/>
                                    <TextBlock Text="Bookings"
                                               Foreground="#666666"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#F4F6F8"
                                    CornerRadius="10"
                                    Padding="20">
                                <StackPanel>
                                    <TextBlock x:Name="InactiveActivitiesCountTextBlock"
                                               Text="0"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               Foreground="Black"/>
                                    <TextBlock Text="Inactive Activities"
                                               Foreground="#666666"/>
                                </StackPanel>
                            </Border>

                        </UniformGrid>

                        <TextBlock x:Name="DashboardMessageTextBlock"
                                   Text="Select an option from the menu."
                                   FontSize="14"
                                   Foreground="#777777"/>

                        <!-- Create Event Form -->
                        <Border x:Name="CreateEventFormPanel"
                                IsVisible="False"
                                Background="#F4F6F8"
                                CornerRadius="12"
                                Padding="20">

                            <StackPanel Spacing="12">

                                <TextBlock Text="Create New Event / Course"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="Black"/>

                                <TextBox x:Name="EventTitleTextBox"
                                         Watermark="Title"
                                         Height="36"/>

                                <ComboBox x:Name="CreateItemTypeComboBox"
                                        PlaceholderText="Select type"
                                        Height="36"
                                        HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Event"/>
                                    <ComboBoxItem Content="Course"/>
                                </ComboBox>

                                <ComboBox x:Name="EventCategoryComboBox"
                                          PlaceholderText="Select category"
                                          Height="36"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Water Sports"/>
                                    <ComboBoxItem Content="Mountain Activities"/>
                                    <ComboBoxItem Content="Fitness &amp; Wellness"/>
                                    <ComboBoxItem Content="Team Sports"/>
                                    <ComboBoxItem Content="Outdoor Adventure"/>
                                    <ComboBoxItem Content="Cultural Activities"/>
                                    <ComboBoxItem Content="Creative Workshops"/>
                                    <ComboBoxItem Content="Food &amp; Drink Experiences"/>
                                    <ComboBoxItem Content="Kids Activities"/>
                                    <ComboBoxItem Content="Extreme Sports"/>
                                    <ComboBoxItem Content="Winter Sports"/>
                                    <ComboBoxItem Content="Dance &amp; Music"/>
                                    <ComboBoxItem Content="Educational Activities"/>
                                    <ComboBoxItem Content="Tours &amp; Excursions"/>
                                    <ComboBoxItem Content="Other"/>
                                </ComboBox>

                                <TextBox x:Name="EventDescriptionTextBox"
                                         Watermark="Description"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="80"/>

                                <Grid ColumnDefinitions="*,*">
                                    <TextBox x:Name="EventLatitudeTextBox"
                                             Grid.Column="0"
                                             Watermark="Latitude"
                                             Height="36"
                                             Margin="0,0,8,0"/>

                                    <TextBox x:Name="EventLongitudeTextBox"
                                             Grid.Column="1"
                                             Watermark="Longitude"
                                             Height="36"
                                             Margin="8,0,0,0"/>
                                </Grid>

                                <TextBox x:Name="EventAddressTextBox"
                                         Watermark="Address"
                                         Height="36"/>

                                <!-- Event schedule fields -->
                                <StackPanel x:Name="EventSchedulePanel"
                                            Spacing="8">

                                    <Grid ColumnDefinitions="*,*">
                                        <DatePicker x:Name="EventDatePicker"
                                                    Grid.Column="0"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="0,0,8,0"/>

                                        <TextBox x:Name="EventTimeTextBox"
                                                Grid.Column="1"
                                                Watermark="Event time e.g. 10:30"
                                                Height="36"
                                                Margin="8,0,0,0"/>
                                    </Grid>

                                </StackPanel>

                                <!-- Course schedule fields -->
                                <StackPanel x:Name="CourseSchedulePanel"
                                            IsVisible="False"
                                            Spacing="8">

                                    <TextBox x:Name="CourseDaysTextBox"
                                            Watermark="Course days e.g. Monday, Wednesday, Friday"
                                            Height="36"/>

                                    <Grid ColumnDefinitions="*,*">
                                        <TextBox x:Name="CourseStartTimeTextBox"
                                                Grid.Column="0"
                                                Watermark="Start time e.g. 18:00"
                                                Height="36"
                                                Margin="0,0,8,0"/>

                                        <TextBox x:Name="CourseEndTimeTextBox"
                                                Grid.Column="1"
                                                Watermark="End time e.g. 19:30"
                                                Height="36"
                                                Margin="8,0,0,0"/>
                                    </Grid>

                                    <TextBox x:Name="CourseAgeRestrictionTextBox"
                                            Watermark="Age restriction e.g. All ages, 12+, 18+"
                                            Height="36"/>

                                </StackPanel>

                                <Grid ColumnDefinitions="*,*">
                                    <TextBox x:Name="EventPriceTextBox"
                                             Grid.Column="0"
                                             Watermark="Price"
                                             Height="36"
                                             Margin="0,0,8,0"/>

                                    <TextBox x:Name="EventMaxSpaceTextBox"
                                             Grid.Column="1"
                                             Watermark="Max Space"
                                             Height="36"
                                             Margin="8,0,0,0"/>
                                </Grid>

                                <TextBox x:Name="EventGalleryTextBox"
                                         Watermark="Gallery image paths separated by comma"
                                         Height="36"/>

                                <ComboBox x:Name="EventStatusComboBox"
                                          PlaceholderText="Select status"
                                          Height="36"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Active"/>
                                    <ComboBoxItem Content="Inactive"/>
                                </ComboBox>

                                <Grid ColumnDefinitions="*,*">
                                    <Button x:Name="SaveEventButton"
                                            Grid.Column="0"
                                            Content="Save"
                                            Height="38"
                                            Background="#D0D0D0"
                                            Foreground="Black"
                                            HorizontalContentAlignment="Center"
                                            Margin="0,0,8,0"/>

                                    <Button x:Name="CancelCreateEventButton"
                                            Grid.Column="1"
                                            Content="Cancel/Close"
                                            Height="38"
                                            Background="#E6E6E6"
                                            Foreground="Black"
                                            HorizontalContentAlignment="Center"
                                            Margin="8,0,0,0"/>
                                </Grid>

                                <TextBlock x:Name="CreateEventMessageTextBlock"
                                           Text=""
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="Red"/>

                            </StackPanel>

                        </Border>

                        <!-- Provider events list -->
                        <Border Background="#F4F6F8"
                                CornerRadius="12"
                                Padding="20">

                            <StackPanel Spacing="10">

                                <Grid ColumnDefinitions="*,180"
                                    Margin="0,0,0,6">

                                    <TextBlock Grid.Column="0"
                                            Text="My Created Activities"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="Black"
                                            VerticalAlignment="Center"/>

                                    <ComboBox x:Name="ProviderActivityFilterComboBox"
                                            Grid.Column="1"
                                            Height="34"
                                            SelectedIndex="0"
                                            HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="All"/>
                                        <ComboBoxItem Content="Events"/>
                                        <ComboBoxItem Content="Courses"/>
                                    </ComboBox>

                                </Grid>

                                <ItemsControl x:Name="ProviderEventsItemsControl">
                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate DataType="{x:Type models:ProviderActivityListItem}">

                                            <Border Background="White"
                                                    CornerRadius="8"
                                                    Padding="12"
                                                    Margin="0,0,0,8">

                                                <StackPanel Spacing="5">

                                                    <Grid ColumnDefinitions="*,Auto">

                                                        <TextBlock Grid.Column="0"
                                                                Text="{Binding Title}"
                                                                FontSize="16"
                                                                FontWeight="Bold"
                                                                Foreground="Black"
                                                                TextWrapping="Wrap"/>

                                                        <Border Grid.Column="1"
                                                                Background="#E5E7EB"
                                                                CornerRadius="10"
                                                                Padding="8,3"
                                                                Margin="8,0,0,0">

                                                            <TextBlock Text="{Binding ActivityType}"
                                                                    FontSize="12"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="#374151"/>

                                                        </Border>

                                                    </Grid>

                                                    <TextBlock Text="{Binding Category}"
                                                            FontSize="13"
                                                            Foreground="#555555"/>

                                                    <TextBlock Text="{Binding Address}"
                                                            FontSize="13"
                                                            Foreground="#555555"
                                                            TextWrapping="Wrap"/>

                                                    <TextBlock Text="{Binding ScheduleText}"
                                                            FontSize="13"
                                                            Foreground="#555555"/>

                                                    <TextBlock Text="{Binding Status}"
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            Foreground="#777777"/>

                                                </StackPanel>

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</UserControl>