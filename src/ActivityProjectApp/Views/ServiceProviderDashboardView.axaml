<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ActivityProjectApp.Models"
             x:Class="ActivityProjectApp.Views.ServiceProviderDashboardView"
             Background="#F4F6F8">

    <UserControl.Styles>

        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E3A8A"/>
        </Style>

        <Style Selector="TextBlock.subsection-title">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>

        <Style Selector="Button.menu-button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">

                        <ContentPresenter Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Padding="{TemplateBinding Padding}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>

                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.menu-button:pointerover">
            <Setter Property="Background" Value="#EEF2F7"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <Style Selector="Button.dashboard-summary-card">
            <Setter Property="Height" Value="128"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.dashboard-summary-card:pointerover">
            <Setter Property="Background" Value="#EEF2F7"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <Style Selector="Button.dashboard-summary-card.active">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
        </Style>

        <Style Selector="Button.settings-tab-card">
            <Setter Property="Height" Value="95"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.settings-tab-card:pointerover">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <Style Selector="Button.settings-tab-card.active">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#9CA3AF"/>
        </Style>

        <Style Selector="Button.card-action-button">
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.card-action-button.edit-activity-button">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="Foreground" Value="#1D4ED8"/>
            <Setter Property="BorderBrush" Value="#BFDBFE"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.card-action-button.edit-activity-button:pointerover">
            <Setter Property="Background" Value="#DBEAFE"/>
        </Style>

        <Style Selector="Button.card-action-button.delete-activity-button">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.card-action-button.delete-activity-button:pointerover">
            <Setter Property="Background" Value="#FECACA"/>
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*"
          Background="#F4F6F8">

        <!-- Top bar -->
        <Border Grid.Row="0"
                Background="White"
                Padding="24,18"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

            <Grid ColumnDefinitions="*,Auto">

                <StackPanel Grid.Column="0"
                            Spacing="4">

                    <TextBlock Text="Service Provider Dashboard"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#1E3A8A"/>

                    <TextBlock x:Name="WelcomeTextBlock"
                               Text="Welcome"
                               FontSize="14"
                               Foreground="#6B7280"/>

                </StackPanel>

                <Button x:Name="LogoutButton"
                        Grid.Column="1"
                        Content="Logout"
                        Width="110"
                        Height="38"
                        Background="#F8FAFC"
                        Foreground="#1F2937"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="10"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>

            </Grid>

        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1"
              Margin="30"
              ColumnDefinitions="260,*">

            <!-- Side menu -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="16"
                    Padding="20"
                    Margin="0,0,25,0"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                <StackPanel Spacing="12">

                    <TextBlock Text="Menu"
                               Classes="section-title"
                               Margin="0,0,0,8"/>

                    <Button x:Name="CreateEventButton"
                            Classes="menu-button"
                            Content="Create Event / Course"/>

                    <Button x:Name="MyActivitiesButton"
                            Classes="menu-button"
                            Content="My Courses / Events"/>

                    <Button x:Name="AnnouncementsButton"
                            Classes="menu-button"
                            Content="Create Announcement"/>

                    <Button x:Name="MyAnnouncementsButton"
                            Classes="menu-button"
                            Content="My Announcements"/>

                    <Button x:Name="SettingsButton"
                            Classes="menu-button"
                            Content="Settings"/>

                </StackPanel>

            </Border>

            <!-- Dashboard area -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="16"
                    Padding="28"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Spacing="18">

                        <TextBlock Text="Overview"
                                   Classes="section-title"/>

                        <TextBlock Text="This is the main page for service providers. From here, providers can create and manage events, courses and announcements."
                                   FontSize="14"
                                   Foreground="#555555"
                                   TextWrapping="Wrap"/>

                        <!-- Overview cards -->
                        <Grid ColumnDefinitions="*,*,*"
                              Margin="0,0,0,4">

                            <Button x:Name="MyEventsSummaryButton"
                                    Grid.Column="0"
                                    Classes="dashboard-summary-card"
                                    Margin="0,0,10,0">

                                <StackPanel Spacing="6">

                                    <TextBlock x:Name="MyEventsCountTextBlock"
                                               Text="0"
                                               FontSize="34"
                                               FontWeight="Bold"
                                               Foreground="#111827"/>

                                    <TextBlock Text="My Events"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#1E3A8A"/>

                                    <TextBlock Text="View all created events"
                                               FontSize="12"
                                               Foreground="#6B7280"
                                               TextWrapping="Wrap"/>

                                </StackPanel>

                            </Button>

                            <Button x:Name="MyCoursesSummaryButton"
                                    Grid.Column="1"
                                    Classes="dashboard-summary-card"
                                    Margin="5,0,5,0">

                                <StackPanel Spacing="6">

                                    <TextBlock x:Name="MyCoursesCountTextBlock"
                                               Text="0"
                                               FontSize="34"
                                               FontWeight="Bold"
                                               Foreground="#111827"/>

                                    <TextBlock Text="My Courses"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#1E3A8A"/>

                                    <TextBlock Text="View all created courses"
                                               FontSize="12"
                                               Foreground="#6B7280"
                                               TextWrapping="Wrap"/>

                                </StackPanel>

                            </Button>

                            <Button x:Name="MyAnnouncementsSummaryButton"
                                    Grid.Column="2"
                                    Classes="dashboard-summary-card"
                                    Margin="10,0,0,0">

                                <StackPanel Spacing="6">

                                    <TextBlock x:Name="MyAnnouncementsCountTextBlock"
                                               Text="0"
                                               FontSize="34"
                                               FontWeight="Bold"
                                               Foreground="#111827"/>

                                    <TextBlock Text="My Announcements"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#1E3A8A"/>

                                    <TextBlock Text="View published announcements"
                                               FontSize="12"
                                               Foreground="#6B7280"
                                               TextWrapping="Wrap"/>

                                </StackPanel>

                            </Button>

                        </Grid>

                        <TextBlock x:Name="DashboardMessageTextBlock"
                                   Text="Select an option from the menu."
                                   FontSize="14"
                                   Foreground="#777777"/>
                        <Border x:Name="DeleteConfirmationPanel"
                                IsVisible="False"
                                Background="#FEF2F2"
                                CornerRadius="12"
                                Padding="14"
                                BorderBrush="#FECACA"
                                BorderThickness="1">

                            <Grid ColumnDefinitions="*,Auto,Auto">

                                <TextBlock x:Name="DeleteConfirmationTextBlock"
                                        Grid.Column="0"
                                        Text="Are you sure you want to delete this item?"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#991B1B"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap"/>

                                <Button x:Name="ConfirmDeleteButton"
                                        Grid.Column="1"
                                        Content="Delete"
                                        Width="90"
                                        Height="34"
                                        Background="#DC2626"
                                        Foreground="White"
                                        BorderBrush="#DC2626"
                                        CornerRadius="8"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Margin="12,0,8,0"/>

                                <Button x:Name="CancelDeleteButton"
                                        Grid.Column="2"
                                        Content="Cancel"
                                        Width="90"
                                        Height="34"
                                        Background="#F8FAFC"
                                        Foreground="#1F2937"
                                        BorderBrush="#E5E7EB"
                                        CornerRadius="8"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"/>

                            </Grid>

                        </Border>

                        <!-- Create Event / Course Form -->
                        <Border x:Name="CreateEventFormPanel"
                                IsVisible="False"
                                Background="#F4F6F8"
                                CornerRadius="14"
                                Padding="20"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">

                            <StackPanel Spacing="12">

                                <TextBlock Text="Create New Event / Course"
                                           Classes="subsection-title"/>

                                <TextBox x:Name="EventTitleTextBox"
                                         Watermark="Title"
                                         Height="36"/>

                                <ComboBox x:Name="CreateItemTypeComboBox"
                                          PlaceholderText="Select type"
                                          Height="36"
                                          HorizontalAlignment="Stretch">

                                    <ComboBoxItem Content="Event"/>
                                    <ComboBoxItem Content="Course"/>

                                </ComboBox>

                                <ComboBox x:Name="EventCategoryComboBox"
                                          PlaceholderText="Select category"
                                          Height="36"
                                          HorizontalAlignment="Stretch">

                                    <ComboBoxItem Content="Water Sports"/>
                                    <ComboBoxItem Content="Mountain Activities"/>
                                    <ComboBoxItem Content="Fitness &amp; Wellness"/>
                                    <ComboBoxItem Content="Team Sports"/>
                                    <ComboBoxItem Content="Outdoor Adventure"/>
                                    <ComboBoxItem Content="Cultural Activities"/>
                                    <ComboBoxItem Content="Creative Workshops"/>
                                    <ComboBoxItem Content="Food &amp; Drink Experiences"/>
                                    <ComboBoxItem Content="Kids Activities"/>
                                    <ComboBoxItem Content="Extreme Sports"/>
                                    <ComboBoxItem Content="Winter Sports"/>
                                    <ComboBoxItem Content="Dance &amp; Music"/>
                                    <ComboBoxItem Content="Educational Activities"/>
                                    <ComboBoxItem Content="Tours &amp; Excursions"/>
                                    <ComboBoxItem Content="Other"/>

                                </ComboBox>

                                <TextBox x:Name="EventDescriptionTextBox"
                                         Watermark="Description"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="80"/>

                                <Grid ColumnDefinitions="*,*">

                                    <TextBox x:Name="EventLatitudeTextBox"
                                             Grid.Column="0"
                                             Watermark="Latitude"
                                             Height="36"
                                             Margin="0,0,8,0"/>

                                    <TextBox x:Name="EventLongitudeTextBox"
                                             Grid.Column="1"
                                             Watermark="Longitude"
                                             Height="36"
                                             Margin="8,0,0,0"/>

                                </Grid>

                                <TextBox x:Name="EventAddressTextBox"
                                         Watermark="Address"
                                         Height="36"/>

                                <!-- Event schedule fields -->
                                <StackPanel x:Name="EventSchedulePanel"
                                            Spacing="8">

                                    <Grid ColumnDefinitions="*,*">

                                        <DatePicker x:Name="EventDatePicker"
                                                    Grid.Column="0"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="0,0,8,0"/>

                                        <TextBox x:Name="EventTimeTextBox"
                                                 Grid.Column="1"
                                                 Watermark="Event time e.g. 10:30"
                                                 Height="36"
                                                 Margin="8,0,0,0"/>

                                    </Grid>

                                </StackPanel>

                                <!-- Course schedule fields -->
                                <StackPanel x:Name="CourseSchedulePanel"
                                            IsVisible="False"
                                            Spacing="8">

                                    <TextBox x:Name="CourseDaysTextBox"
                                             Watermark="Course days e.g. Monday, Wednesday, Friday"
                                             Height="36"/>

                                    <Grid ColumnDefinitions="*,*">

                                        <TextBox x:Name="CourseStartTimeTextBox"
                                                 Grid.Column="0"
                                                 Watermark="Start time e.g. 18:00"
                                                 Height="36"
                                                 Margin="0,0,8,0"/>

                                        <TextBox x:Name="CourseEndTimeTextBox"
                                                 Grid.Column="1"
                                                 Watermark="End time e.g. 19:30"
                                                 Height="36"
                                                 Margin="8,0,0,0"/>

                                    </Grid>

                                    <TextBox x:Name="CourseAgeRestrictionTextBox"
                                             Watermark="Age restriction e.g. All ages, 12+, 18+"
                                             Height="36"/>

                                </StackPanel>

                                <Grid ColumnDefinitions="*,*">

                                    <TextBox x:Name="EventPriceTextBox"
                                             Grid.Column="0"
                                             Watermark="Price"
                                             Height="36"
                                             Margin="0,0,8,0"/>

                                    <TextBox x:Name="EventMaxSpaceTextBox"
                                             Grid.Column="1"
                                             Watermark="Max Space"
                                             Height="36"
                                             Margin="8,0,0,0"/>

                                </Grid>

                                <TextBox x:Name="EventGalleryTextBox"
                                         Watermark="Gallery image paths separated by comma"
                                         Height="36"/>

                                <ComboBox x:Name="EventStatusComboBox"
                                          PlaceholderText="Select status"
                                          Height="36"
                                          HorizontalAlignment="Stretch">

                                    <ComboBoxItem Content="Active"/>
                                    <ComboBoxItem Content="Inactive"/>

                                </ComboBox>

                                <Grid ColumnDefinitions="*,*">

                                    <Button x:Name="SaveEventButton"
                                            Grid.Column="0"
                                            Content="Publish"
                                            Height="38"
                                            Background="#D0D0D0"
                                            Foreground="Black"
                                            HorizontalContentAlignment="Center"
                                            Margin="0,0,8,0"/>

                                    <Button x:Name="CancelCreateEventButton"
                                            Grid.Column="1"
                                            Content="Cancel/Close"
                                            Height="38"
                                            Background="#E6E6E6"
                                            Foreground="Black"
                                            HorizontalContentAlignment="Center"
                                            Margin="8,0,0,0"/>

                                </Grid>

                                <TextBlock x:Name="CreateEventMessageTextBlock"
                                           Text=""
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="Red"/>

                            </StackPanel>

                        </Border>

                        <!-- Create Announcement Form -->
                        <Border x:Name="CreateAnnouncementFormPanel"
                                IsVisible="False"
                                Background="#F4F6F8"
                                CornerRadius="14"
                                Padding="20"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">

                            <StackPanel Spacing="12">

                                <TextBlock Text="Create Announcement"
                                           Classes="subsection-title"/>

                                <TextBox x:Name="AnnouncementTitleTextBox"
                                         Watermark="Announcement title"
                                         Height="36"/>

                                <TextBox x:Name="AnnouncementTextTextBox"
                                         Watermark="Announcement text"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="90"/>

                                <ComboBox x:Name="AnnouncementTargetModeComboBox"
                                        PlaceholderText="Select announcement audience"
                                        Height="36"
                                        HorizontalAlignment="Stretch"
                                        SelectedIndex="0">

                                    <ComboBoxItem Content="All Events and Courses"/>
                                    <ComboBoxItem Content="All Events"/>
                                    <ComboBoxItem Content="All Courses"/>
                                    <ComboBoxItem Content="Custom Selection"/>

                                </ComboBox>

                                <Border x:Name="AnnouncementTargetsPanel"
                                        Background="White"
                                        CornerRadius="10"
                                        Padding="12"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1">

                                    <StackPanel Spacing="8">

                                        <TextBlock Text="Select related events/courses"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="#374151"/>

                                        <TextBlock x:Name="AnnouncementTargetsHelpTextBlock"
                                                Text="Targets are selected automatically based on the option above."
                                                FontSize="12"
                                                Foreground="#6B7280"
                                                TextWrapping="Wrap"/>

                                        <ScrollViewer MaxHeight="180"
                                                    VerticalScrollBarVisibility="Auto">

                                            <ItemsControl x:Name="AnnouncementTargetItemsControl">

                                                <ItemsControl.ItemTemplate>

                                                    <DataTemplate DataType="{x:Type models:AnnouncementTargetSelectionItem}">

                                                        <CheckBox Content="{Binding DisplayText}"
                                                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                Margin="0,0,0,6"
                                                                VerticalContentAlignment="Center"/>

                                                    </DataTemplate>

                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>

                                        </ScrollViewer>

                                    </StackPanel>

                                </Border>

                                <TextBox x:Name="AnnouncementGalleryTextBox"
                                         Watermark="Gallery image paths separated by comma"
                                         Height="36"/>

                                <ComboBox x:Name="AnnouncementStatusComboBox"
                                          PlaceholderText="Select status"
                                          Height="36"
                                          HorizontalAlignment="Stretch"
                                          SelectedIndex="0">

                                    <ComboBoxItem Content="Active"/>
                                    <ComboBoxItem Content="Inactive"/>

                                </ComboBox>

                                <Grid ColumnDefinitions="*,*">

                                    <Button x:Name="PublishAnnouncementButton"
                                            Grid.Column="0"
                                            Content="Publish"
                                            Height="38"
                                            Background="#D0D0D0"
                                            Foreground="Black"
                                            HorizontalContentAlignment="Center"
                                            Margin="0,0,8,0"/>

                                    <Button x:Name="CancelAnnouncementButton"
                                            Grid.Column="1"
                                            Content="Cancel/Close"
                                            Height="38"
                                            Background="#E6E6E6"
                                            Foreground="Black"
                                            HorizontalContentAlignment="Center"
                                            Margin="8,0,0,0"/>

                                </Grid>

                                <TextBlock x:Name="AnnouncementMessageTextBlock"
                                           Text=""
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="Red"/>

                            </StackPanel>

                        </Border>

                        <!-- Provider activities list -->
                        <Border x:Name="ProviderActivitiesPanel"
                                IsVisible="False"
                                Background="#F4F6F8"
                                CornerRadius="14"
                                Padding="20"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">

                            <StackPanel Spacing="10">

                                <Grid ColumnDefinitions="*,180"
                                      Margin="0,0,0,6">

                                    <TextBlock x:Name="ProviderActivitiesTitleTextBlock"
                                               Grid.Column="0"
                                               Text="My Courses / Events"
                                               Classes="subsection-title"
                                               VerticalAlignment="Center"/>

                                    <ComboBox x:Name="ProviderActivityFilterComboBox"
                                              Grid.Column="1"
                                              Height="34"
                                              SelectedIndex="0"
                                              HorizontalAlignment="Stretch">

                                        <ComboBoxItem Content="All"/>
                                        <ComboBoxItem Content="Events"/>
                                        <ComboBoxItem Content="Courses"/>

                                    </ComboBox>

                                </Grid>

                                <ItemsControl x:Name="ProviderEventsItemsControl">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate DataType="{x:Type models:ProviderActivityListItem}">

                                            <Border Background="White"
                                                    CornerRadius="10"
                                                    Padding="14"
                                                    Margin="0,0,0,8"
                                                    BorderBrush="#E5E7EB"
                                                    BorderThickness="1">

                                                <StackPanel Spacing="5">

                                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">

                                                        <TextBlock Grid.Column="0"
                                                                Text="{Binding Title}"
                                                                FontSize="16"
                                                                FontWeight="Bold"
                                                                Foreground="Black"
                                                                TextWrapping="Wrap"
                                                                VerticalAlignment="Center"/>

                                                        <Border Grid.Column="1"
                                                                Background="#E5E7EB"
                                                                CornerRadius="10"
                                                                Padding="8,3"
                                                                Margin="8,0,8,0"
                                                                VerticalAlignment="Center">

                                                            <TextBlock Text="{Binding ActivityType}"
                                                                    FontSize="12"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="#374151"/>

                                                        </Border>

                                                        <Button Grid.Column="2"
                                                                Classes="card-action-button edit-activity-button"
                                                                Content="Edit"
                                                                Tag="{Binding}"
                                                                Margin="0,0,8,0"/>

                                                        <Button Grid.Column="3"
                                                                Classes="card-action-button delete-activity-button"
                                                                Content="Delete"
                                                                Tag="{Binding}"/>

                                                    </Grid>

                                                    <TextBlock Text="{Binding Category}"
                                                               FontSize="13"
                                                               Foreground="#555555"/>

                                                    <TextBlock Text="{Binding Address}"
                                                               FontSize="13"
                                                               Foreground="#555555"
                                                               TextWrapping="Wrap"/>

                                                    <TextBlock Text="{Binding ScheduleText}"
                                                               FontSize="13"
                                                               Foreground="#555555"/>

                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#777777"/>

                                                </StackPanel>

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </StackPanel>

                        </Border>

                        <!-- Provider announcements list -->
                        <Border x:Name="ProviderAnnouncementsPanel"
                                IsVisible="False"
                                Background="#F4F6F8"
                                CornerRadius="14"
                                Padding="20"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">

                            <StackPanel Spacing="10">

                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock Grid.Column="0"
                                               Text="My Announcements"
                                               Classes="subsection-title"
                                               VerticalAlignment="Center"/>

                                    <TextBlock x:Name="ProviderAnnouncementsCountTextBlock"
                                               Grid.Column="1"
                                               Text="0 announcements"
                                               FontSize="13"
                                               Foreground="#666666"
                                               VerticalAlignment="Center"/>

                                </Grid>

                                <ItemsControl x:Name="ProviderAnnouncementsItemsControl">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate DataType="{x:Type models:Announcement}">

                                            <Border Background="White"
                                                    CornerRadius="10"
                                                    Padding="14"
                                                    Margin="0,0,0,8"
                                                    BorderBrush="#E5E7EB"
                                                    BorderThickness="1">

                                                <StackPanel Spacing="5">

                                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">

                                                        <TextBlock Grid.Column="0"
                                                                Text="{Binding Title}"
                                                                FontSize="16"
                                                                FontWeight="Bold"
                                                                Foreground="Black"
                                                                TextWrapping="Wrap"
                                                                VerticalAlignment="Center"/>

                                                        <Border Grid.Column="1"
                                                                Background="#E5E7EB"
                                                                CornerRadius="10"
                                                                Padding="8,3"
                                                                Margin="8,0,8,0"
                                                                VerticalAlignment="Center">

                                                            <TextBlock Text="{Binding IsActive}"
                                                                    FontSize="12"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="#374151"/>

                                                        </Border>

                                                        <Button Grid.Column="2"
                                                                Classes="card-action-button edit-activity-button"
                                                                Content="Edit"
                                                                Tag="{Binding}"
                                                                Margin="0,0,8,0"/>

                                                        <Button Grid.Column="3"
                                                                Classes="card-action-button delete-activity-button"
                                                                Content="Delete"
                                                                Tag="{Binding}"/>

                                                    </Grid>
                                                    <TextBlock Text="Announcement"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#555555"/>

                                                    <TextBlock Text="{Binding Text}"
                                                               FontSize="13"
                                                               Foreground="#555555"
                                                               TextWrapping="Wrap"/>

                                                    <TextBlock Text="{Binding AnnouncementDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                               FontSize="12"
                                                               Foreground="#777777"/>

                                                </StackPanel>

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </StackPanel>

                        </Border>

                        <!-- Settings panel -->
                        <Border x:Name="SettingsPanel"
                                IsVisible="False"
                                Background="#F4F6F8"
                                CornerRadius="14"
                                Padding="20"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">

                            <StackPanel Spacing="14">

                                <TextBlock Text="Settings"
                                           Classes="subsection-title"/>

                                <Grid ColumnDefinitions="*,*">

                                    <Button x:Name="ProfileSettingsButton"
                                            Grid.Column="0"
                                            Classes="settings-tab-card"
                                            Margin="0,0,8,0">

                                        <StackPanel Spacing="4">

                                            <TextBlock Text="Profile Settings"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="#111827"/>

                                            <TextBlock Text="Password, contact details and provider profile"
                                                       FontSize="12"
                                                       Foreground="#6B7280"
                                                       TextWrapping="Wrap"/>

                                        </StackPanel>

                                    </Button>

                                    <Button x:Name="ManagementSettingsButton"
                                            Grid.Column="1"
                                            Classes="settings-tab-card"
                                            Margin="8,0,0,0">

                                        <StackPanel Spacing="4">

                                            <TextBlock Text="Activity Management"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="#111827"/>

                                            <TextBlock Text="Settings for events, courses and announcements"
                                                       FontSize="12"
                                                       Foreground="#6B7280"
                                                       TextWrapping="Wrap"/>

                                        </StackPanel>

                                    </Button>

                                </Grid>

                                <!-- Profile Settings content -->
                                <Border x:Name="ProfileSettingsContentPanel"
                                        Background="White"
                                        CornerRadius="10"
                                        Padding="16"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1">

                                    <StackPanel Spacing="10">

                                        <TextBlock Text="Profile Settings"
                                                   Classes="subsection-title"/>

                                        <Button Content="Change Password"
                                                Height="38"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"/>

                                        <Button Content="Update Provider Profile"
                                                Height="38"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"/>

                                        <Button Content="Update Contact Details"
                                                Height="38"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"/>

                                        <TextBlock Text="These options will be implemented later."
                                                   FontSize="13"
                                                   Foreground="#6B7280"
                                                   TextWrapping="Wrap"/>

                                    </StackPanel>

                                </Border>

                                <!-- Management Settings content -->
                                <Border x:Name="ManagementSettingsContentPanel"
                                        IsVisible="False"
                                        Background="White"
                                        CornerRadius="10"
                                        Padding="16"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1">

                                    <StackPanel Spacing="10">

                                        <TextBlock Text="Activity Management Settings"
                                                   Classes="subsection-title"/>

                                        <Button Content="Manage Events"
                                                Height="38"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"/>

                                        <Button Content="Manage Courses"
                                                Height="38"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"/>

                                        <Button Content="Manage Announcements"
                                                Height="38"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"/>

                                        <TextBlock Text="These settings will be used later for editing, activating/deactivating or deleting created items."
                                                   FontSize="13"
                                                   Foreground="#6B7280"
                                                   TextWrapping="Wrap"/>

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</UserControl>